        eprosima::fastcdr::Cdr& cdr,
        map2stitch_msgs::msg::ImageSensorFrame& data)
{
    using namespace map2stitch_msgs::msg;

    cdr.deserialize_type(eprosima::fastcdr::CdrVersion::XCDRv2 == cdr.get_cdr_version() ?
            eprosima::fastcdr::EncodingAlgorithmFlag::DELIMIT_CDR2 :
            eprosima::fastcdr::EncodingAlgorithmFlag::PLAIN_CDR,
            [&data](eprosima::fastcdr::Cdr& dcdr, const eprosima::fastcdr::MemberId& mid) -> bool
            {
                bool ret_value = true;
                switch (mid.id)
                {
                                        case 0:
                                                dcdr >> data.stream_id();
                                            break;

                                        case 1:
                                                dcdr >> data.frame_id();
                                            break;

                                        case 2:
                                                dcdr >> data.timestamp_sec();
                                            break;

                                        case 3:
                                                dcdr >> data.image_encoding();
                                            break;

                                        case 4:
                                                dcdr >> data.image_width();
                                            break;

                                        case 5:
                                                dcdr >> data.image_height();
                                            break;

                                        case 6:
                                                dcdr >> data.image_total_length();
                                            break;

                                        case 7:
                                                dcdr >> data.expected_chunk_count();
                                            break;

                                        case 8:
                                                dcdr >> data.has_gps();
                                            break;

                                        case 9:
                                                dcdr >> data.gps();
                                            break;

                                        case 10:
                                                dcdr >> data.has_local_position();
                                            break;

                                        case 11:
                                                dcdr >> data.local_position_m();
                                            break;

                                        case 12:
                                                dcdr >> data.has_camera_pose();
                                            break;

                                        case 13:
                                                dcdr >> data.camera_position_m();
                                            break;

                                        case 14:
                                                dcdr >> data.camera_orientation();
                                            break;

                                        case 15:
                                                dcdr >> data.has_imu();
                                            break;

                                        case 16:
                                                dcdr >> data.imu_accel_mps2();
                                            break;

                                        case 17:
                                                dcdr >> data.imu_gyro_rps();
                                            break;

                                        case 18:
                                                dcdr >> data.has_intrinsics();
                                            break;

                                        case 19:
                                                dcdr >> data.camera_intrinsics_id();
                                            break;

                                        case 20:
                                                dcdr >> data.intrinsics();
                                            break;

                    default:
                        ret_value = false;
                        break;
                }
                return ret_value;
            });
}

