<Window x:Class="FacadePreviewer.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Title=" ">
    <Border MinWidth="380" MaxWidth="520" Padding="20" Background="{StaticResource Bg}">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
