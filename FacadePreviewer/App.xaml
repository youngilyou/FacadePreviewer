<Application x:Class="FacadePreviewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FacadePreviewer"
             xmlns:conv="clr-namespace:FacadePreviewer.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <!-- ===== palette (matches CheckCrackViewer for visual consistency) ===== -->
            <SolidColorBrush x:Key="Bg" Color="#14181A"/>
            <SolidColorBrush x:Key="Surface" Color="#1C2124"/>
            <SolidColorBrush x:Key="Surface2" Color="#242A2D"/>
            <SolidColorBrush x:Key="Border" Color="#333B3E"/>
            <SolidColorBrush x:Key="Text" Color="#E7E9E4"/>
            <SolidColorBrush x:Key="Text2" Color="#9AA39C"/>
            <SolidColorBrush x:Key="Accent" Color="#FF6A3D"/>
            <SolidColorBrush x:Key="Good" Color="#57C98C"/>
            <SolidColorBrush x:Key="Warn" Color="#E0B13B"/>

            <!-- ===== base styles ===== -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource Bg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontFamily" Value="맑은 고딕"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="Kicker" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
