<Window x:Class="FacadePreviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FacadePreviewer.ViewModels"
        Title="Facade Previewer"
        Width="1320" Height="760" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 촬영 이미지 관리 (left sidebar) =====
             Design review: a fixed-width column added to the LEFT of the whole window, same
             background as the rest of the app (CardBorder's Surface2, not a distinct color);
             the existing right-side content is otherwise left unchanged. Checkbox polarity matches
             TransferSettingsWindow's own review panel for consistency across the app (checked =
             included/keep, default true). Unchecking a frame does not touch its file by itself,
             only clicking "선택 제외" actually moves the currently-unchecked ones into the capture
             folder's "excluded" subfolder and removes them from this list (see
             MainViewModel.RemoveExcludedFrames). Double-click renders that frame's original
             640x640 into the MAIN content area on the right (see OnCapturedFrameThumbnailClicked/
             IsShowingSelectedFrame), not a separate popup. -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="촬영 이미지" Foreground="{StaticResource Text2}" FontSize="16"
                           HorizontalAlignment="Center" Margin="2,0,2,6"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CapturedFrames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="130" Margin="2,0,2,6" BorderThickness="1"
                                        BorderBrush="{StaticResource Border}" Background="{StaticResource Bg}"
                                        Tag="{Binding}" MouseLeftButtonDown="OnCapturedFrameThumbnailClicked">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding ThumbnailSource}" Stretch="Uniform" Margin="2"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="3,0,0,2">
                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Text2}"
                                                       FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2" Content="선택 제외" Command="{Binding RemoveExcludedFramesCommand}"
                        Margin="0,6,0,0" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== header ===== -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FACADE PREVIEWER" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                        <TextBlock Text="  촬영 중엔 캡처만, 촬영 후 스캔" Foreground="{StaticResource Text2}"
                                   FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Text2}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Good}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{StaticResource Text2}"
                                   FontSize="11.5" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding LoggedInUsername, StringFormat='  ·  로그인: {0}'}"
                                   Foreground="{StaticResource Text2}" FontSize="11.5" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                        <Button Content="로그아웃" Command="{Binding LogoutCommand}" Margin="10,0,0,0"
                                Background="Transparent" BorderThickness="0" Padding="4,2"
                                Foreground="{StaticResource Accent}" FontSize="11.5" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== capture status + scan log ===== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- capture status card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,0,8">
                            <Run Text="캡처 상태"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="폴더" Foreground="{StaticResource Text2}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CaptureFolderText}" Foreground="{StaticResource Text}"
                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="저장된 이미지" Foreground="{StaticResource Text2}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CapturedFrameCountDisplay, StringFormat='{}{0}장 (640x640 JPEG, ~2fps)'}"
                                       Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- scan log / result mosaic / selected-original-frame viewer -->
                <!-- [YYIL] 2026-08-13, per user request: once RunScan finishes successfully, this
                     panel switches from the scrolling text log to the rendered analysis mosaic
                     (HasScanResult toggles which of the two children is visible); both stay in the
                     same Grid cell so the switch doesn't reflow the rest of the window. Starting a
                     new capture (StartCapture) resets HasScanResult to false, switching back to the
                     log view for the next facade's run.
                     [YYIL] 2026-08-22: a third state was added. Double-clicking a thumbnail in
                     the left sidebar renders that frame's original here (IsShowingSelectedFrame),
                     with its own zoom/pan/fit-button, per explicit design review asking for this
                     to render in the main area rather than a separate popup window. -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="{StaticResource Text2}" FontSize="11" Margin="8,6,8,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="스캔 로그"/>
                                    <Style.Triggers>
                                        <!-- Listed in ascending priority order (later Setter wins if
                                             multiple conditions are somehow true at once): selected
                                             frame, then scan result last so it always wins. -->
                                        <DataTrigger Binding="{Binding IsShowingSelectedFrame}" Value="True">
                                            <Setter Property="Text" Value="원본 이미지 (더블클릭한 촬영 사진)"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasScanResult}" Value="True">
                                            <Setter Property="Text" Value="스캔 결과 — 스티칭된 모자이크"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 분석 시작 진행률: stitch_folder.py의 JSON 로그 라인을 파싱한 근사치
                             (MainViewModel.TryUpdateScanProgress), 실제 시간 예측이 아니라
                             "멈춘 게 아니라 진행 중"임을 보여주는 용도. IsScanning일 때만 표시. -->
                        <Grid Grid.Row="1" Margin="8,0,8,6">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ScanProgressPercent, Mode=OneWay}"
                                         Height="6" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Background="{StaticResource Surface2}" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                            <TextBlock Grid.Column="1" Foreground="{StaticResource Text2}" FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:0}% — {1}">
                                        <Binding Path="ScanProgressPercent"/>
                                        <Binding Path="ScanStageText"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="2">
                            <!-- Shown before "분석 시작" is ever clicked (ScanLogText still empty,
                                 no result yet); see MainViewModel.RunScan, which is the only place
                                 ScanLogText gets its first line appended. -->
                            <TextBlock Text="준비중" FontSize="40" Foreground="{StaticResource Text2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ScanLogText}" Value=""/>
                                                    <Condition Binding="{Binding HasScanResult}" Value="False"/>
                                                    <Condition Binding="{Binding IsShowingSelectedFrame}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ScanLogScroll">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScanResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShowingSelectedFrame}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <TextBox Text="{Binding ScanLogText, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                         Background="Transparent" Foreground="{StaticResource Text2}"
                                         FontFamily="Consolas" FontSize="11" Padding="8"
                                         TextChanged="OnScanLogTextChanged"/>
                            </ScrollViewer>

                            <!-- Double-clicked original frame: zoom (wheel) + pan (drag), same
                                 transform-based approach as ResultImage below, plus an explicit
                                 "화면 맞춤" button (design review asked for a button in addition to
                                 whatever gesture resets the view, not a gesture alone). -->
                            <Grid x:Name="SelectedFrameContainer" ClipToBounds="True" Background="Transparent"
                                  Cursor="SizeAll"
                                  MouseWheel="OnSelectedFrameMouseWheel"
                                  MouseLeftButtonDown="OnSelectedFrameMouseDown"
                                  MouseMove="OnSelectedFrameMouseMove"
                                  MouseLeftButtonUp="OnSelectedFrameMouseUp"
                                  MouseLeave="OnSelectedFrameMouseLeave"
                                  ToolTip="마우스 휠: 확대/축소 · 드래그: 이동">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingSelectedFrame}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Image x:Name="SelectedFrameImage" Source="{Binding SelectedFrameImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="8"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="SelectedFrameScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="SelectedFrameTranslate" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <Button Content="화면 맞춤" Click="OnSelectedFrameFitClick"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/>
                            </Grid>

                            <!-- Zoom (mouse wheel) + pan (left-drag) + reset (right-click); see
                                 MainWindow.xaml.cs's OnResultImage* handlers. ClipToBounds so a
                                 zoomed/panned image doesn't spill past the card border into the
                                 sibling controls below it. -->
                            <Grid x:Name="ResultImageContainer" ClipToBounds="True" Background="Transparent"
                                  Cursor="SizeAll"
                                  MouseWheel="OnResultImageMouseWheel"
                                  MouseLeftButtonDown="OnResultImageMouseDown"
                                  MouseMove="OnResultImageMouseMove"
                                  MouseLeftButtonUp="OnResultImageMouseUp"
                                  MouseLeave="OnResultImageMouseLeave"
                                  MouseRightButtonDown="OnResultImageResetView"
                                  ToolTip="마우스 휠: 확대/축소 · 드래그: 이동 · 우클릭: 원래 크기">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScanResult}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Image x:Name="ResultImage" Source="{Binding ScanResultImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="8"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ResultImageScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="ResultImageTranslate" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== controls ===== -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <!-- DDS-Router discovery settings: entered on site, see MainViewModel's
                         DdsRouterHost/DdsRouterPort/LocalInterfaceIp doc comment. Capture must be
                         stopped/restarted for a change here to take effect (StartAsync reads
                         these once at capture start). -->
                    <!-- capture root(캡처 저장 위치)도 같은 줄 오른쪽 빈 공간에 이어 붙인다
                         (별도 행 아님) -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="HOST IP" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding DdsRouterHost, UpdateSourceTrigger=PropertyChanged}"
                                     Width="130" Padding="6,4" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     ToolTip="DDS-Router 장비 IP (비워두면 FACADE_DDS_INITIAL_PEER 환경변수 사용)"/>
                            <TextBlock Text="Port" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <TextBox Text="{Binding DdsRouterPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" Padding="6,4" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     ToolTip="DDS 디스커버리 포트 (기본 7410 = domain 0, participant 0)"/>
                            <TextBlock Text="로컬 인터페이스 IP (선택)" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <TextBox Text="{Binding LocalInterfaceIp, UpdateSourceTrigger=PropertyChanged}"
                                     Width="130" Padding="6,4" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     ToolTip="이 PC에서 DDS 통신에 사용할 NIC IP (가상 어댑터가 여러 개일 때만 필요, 비워두면 자동)"/>

                            <TextBlock Text="캡처 저장 위치" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="20,0,8,0"/>
                            <TextBox Text="{Binding CaptureRootPath, UpdateSourceTrigger=PropertyChanged}"
                                     Width="260" Padding="6,4" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     ToolTip="측정장소_날짜시간 폴더가 이 경로 아래 생성됩니다 (예: 외장 드라이브로 변경 가능)"
                                     IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="찾아보기..." Command="{Binding BrowseCaptureRootCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- [YYIL] 2026-08-13: StatusMessage carries the full capture folder path
                         ("캡처 중 6장 저장됨 (d:\...\captures\...)"), which can get long enough to
                         push the button row off the visible window if it shares a horizontal
                         StackPanel with them (a StackPanel gives its children unbounded width, so
                         TextWrapping alone does nothing there; confirmed by the user hitting
                         exactly this: "텍스트가 너무 길어 스티칭을 누를수 없어요"). Buttons now live in
                         their own row, always reachable regardless of status text length; the status
                         text gets its own row below with a bounded width so TextWrapping can
                         actually kick in (capped to ~2 lines via MaxHeight rather than trusting the
                         text to stay short). -->
                    <!-- 촬영현장/동/측정장소(방향) 그룹. 촬영현장은 config/facade_targets.json의
                         첫 회사 이름을 읽기전용으로 보여줌(앱 시작 시 한 번 자동 로드, 이 앱은
                         배포당 한 현장만 다루므로 재로드 버튼이 필요 없음. 수정하려면 파일
                         고치고 재시작). 동/측정장소는 기본은 같은 파일에서 오지만, "촬영지역
                         설정 불러오기..."로 GenerateJson assignment json을 불러오면 그 파일의
                         Buildings/Directions로 교체된다(LoadAssignment). -->
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="촬영현장" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SiteDisplayName}" Foreground="{StaticResource Text}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="동" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}"
                                      Width="110" Padding="6,4" Margin="0,0,20,0"
                                      IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}"/>

                            <TextBlock Text="측정 장소" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding MeasurementLocation}"
                                      Width="110" Padding="6,4"
                                      IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}"/>

                            <!-- 촬영지역 설정(Topic/Key/DRONE json, GenerateJson이 만듦) 불러오기.
                                 예전 "수신 토픽" 콤보박스(config/dds_topics.json)를 대체하는 것,
                                 이제 지역/드론 선택이 previewer 안이 아니라 GenerateJson에서 미리
                                 만든 파일 하나로 넘어온다. Topic은 그 파일에 이미 드론까지 포함돼
                                 있어(예: rt/FacadeImage/DRONE01) previewer가 다시 조합하지 않는다.
                                 별도 "DDS ROUTER에 등록" 버튼은 없앰, 항상 캡처 시작 바로 전에만
                                 눌렀으므로, 실제 등록(_dds.Start)은 캡처 시작 클릭 시
                                 TryEnsureDdsRegistered가 자동으로 처리한다(사용자 요청).
                                 위 촬영현장/동/측정장소와 같은 줄 오른쪽 빈 공간에 이어 붙인다(별도 행 아님). -->
                            <Button Content="촬영지역 설정 불러오기..." Command="{Binding LoadAssignmentCommand}"
                                    IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBoolConverter}}"
                                    Margin="20,0,20,0"/>

                            <TextBlock Text="토픽" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LoadedAssignment.Topic}" Foreground="{StaticResource Text}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="키" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LoadedAssignment.Key}" Foreground="{StaticResource Text}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="드론" Foreground="{StaticResource Text2}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LoadedAssignment.Drone}" Foreground="{StaticResource Text}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="캡처 시작" Command="{Binding StartCaptureCommand}" Margin="0,0,8,0"/>
                            <Button Content="캡처 중지" Command="{Binding StopCaptureCommand}" Margin="0,0,8,0"/>
                            <Button Content="분석 시작" Command="{Binding RunScanCommand}" Margin="0,0,8,0"/>
                            <Button Content="초기화" Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                            <Button Content="고해상도 전송..." Click="OnOpenTransferSettings"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Text2}"
                                   FontSize="11.5" TextWrapping="Wrap" MaxHeight="34"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding SensorFramesReceived, StringFormat='· sensor {0}'}"
                                       Foreground="{StaticResource Text2}" FontSize="11.5"/>
                            <TextBlock Text="{Binding VideoPacketsReceived, StringFormat='· video {0}'}"
                                       Foreground="{StaticResource Text2}" FontSize="11.5" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
